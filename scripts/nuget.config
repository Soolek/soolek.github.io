<?xml version="1.0" encoding="utf-8"?>
<!-- Restores the maintenance scripts from nuget.org only, regardless of the user-level NuGet sources. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
